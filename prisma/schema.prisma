// Norte — fundação (Fase 1)
//
// REGRA INEGOCIÁVEL: toda tabela de dado de cliente carrega orgId.
// Sem exceção, nem "essa é pequena", nem "essa eu arrumo depois".
// Enfiar tenant depois foi o problema de 6 a 10 semanas no sistema anterior.
//
// Isolamento tem DUAS paredes:
//   1. aplicação — todo acesso passa por um cliente já preso a uma Org
//   2. banco — RLS por app.org_id (ver prisma/migrations/rls.sql)
// A parede 2 existe para o dia em que a 1 falhar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: a URL nao mora mais aqui. Vai em prisma.config.ts (migracao)
  // e o PrismaClient recebe um adapter. Ver DECISOES.md.
}

// ─────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────

/// A empresa cliente. É o tenant: tudo pendura aqui.
/// Loja de bairro = 1 Org com 1 Unidade. Rede de 40 = 1 Org com 40 Unidades.
model Org {
  id        String   @id @default(cuid())
  nome      String
  slug      String  @unique // subdomínio / URL
  documento String? // CNPJ
  ramo      String? // atalho que semeia o cadastro; não muda caminho de código

  /// Dados que o sistema inteiro reaproveita: comprovante, nota, cobrança,
  /// e o que o agente responde quando perguntam "onde fica?" ou "que horas
  /// abre?". Preenchidos uma vez, no cadastro inicial.
  razaoSocial       String? @map("razao_social")
  inscricaoEstadual String? @map("inscricao_estadual")
  regime            Regime? // define imposto na nota; o contador informa

  email    String?
  telefone String?
  whatsapp String?

  /// O nome que a empresa deu ao assistente dela. É o agente DELA — cada uma
  /// batiza o seu. A configuração completa (personalidade, poderes, gatilhos)
  /// vem junto com o módulo do agente.
  agenteNome String? @map("agente_nome")

  /// Marca o fim do cadastro inicial. Enquanto for nulo, toda tela leva a
  /// pessoa de volta para terminar — sistema meio configurado confunde mais
  /// que sistema vazio.
  configuradaEm DateTime? @map("configurada_em")

  plano       Plano     @default(BALCAO)
  situacao    Situacao  @default(TESTE)

  /// O que ESTA empresa usa. Quem não vende fiado não vê Crediário em lugar
  /// nenhum — nem no menu, nem em relatório, nem no agente. A chave para
  /// ligar depois mora em Configurações, não no menu.
  ///
  /// Módulo é grosso de propósito: cada chave dobra as combinações a testar.
  /// Com trinta chaves ninguém garante mais que o sistema funciona.
  modulos     String[]  @default([])
  testeAte    DateTime? @map("teste_ate")
  suspensaEm  DateTime? @map("suspensa_em")

  // marca (white-label)
  logoUrl   String? @map("logo_url")
  corMarca  String? @map("cor_marca")

  unidades  Unidade[]
  usuarios  Usuario[]
  acessos   Acesso[]
  convites  Convite[]
  auditoria Auditoria[]
  cobranca  Cobranca?

  categorias     Categoria[]
  eixos          Eixo[]
  opcoes         Opcao[]
  produtos       Produto[]
  produtoEixos   ProdutoEixo[]
  variacoes      Variacao[]
  variacaoOpcoes VariacaoOpcao[]
  estoques       Estoque[]
  movimentos     MovimentoEstoque[]
  clientes       Cliente[]
  caixas         Caixa[]
  caixaMovimentos CaixaMovimento[]
  vendas         Venda[]
  vendaItens     VendaItem[]
  pagamentos     Pagamento[]

  criadaEm     DateTime @default(now()) @map("criada_em")
  atualizadaEm DateTime @updatedAt @map("atualizada_em")

  @@map("orgs")
}

/// Loja, filial ou depósito. Cada uma com seu CNPJ — é o que faz
/// multi-CNPJ funcionar sem caso especial.
model Unidade {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome      String
  documento String? // CNPJ desta unidade
  apelido   String? // como aparece no comprovante

  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  telefone    String?

  /// Texto livre: "Seg a sex 9h-18h, sáb 9h-13h". O agente responde com isto.
  horario String?

  ehDeposito Boolean @default(false) @map("eh_deposito")
  ativa      Boolean @default(true)

  /// Contador do número da venda desta unidade.
  /// Não se calcula "max(numero)+1": duas vendas ao mesmo tempo leriam o mesmo
  /// máximo e pediriam o mesmo número. Aqui o banco incrementa e devolve, numa
  /// operação só, e cada venda leva um número que é só dela.
  proximaVenda Int @default(1) @map("proxima_venda")

  acessos    Acesso[]
  auditoria  Auditoria[]
  estoques   Estoque[]
  movimentos MovimentoEstoque[]
  caixas     Caixa[]
  vendas     Venda[]

  criadaEm     DateTime @default(now()) @map("criada_em")
  atualizadaEm DateTime @updatedAt @map("atualizada_em")

  @@index([orgId])
  @@map("unidades")
}

// ─────────────────────────────────────────────────────────────
// PESSOAS E PERMISSÃO
// ─────────────────────────────────────────────────────────────

/// Quem entra no sistema. Pertence a uma Org.
/// A mesma pessoa em duas empresas são dois usuários — de propósito:
/// nunca deve existir um caminho que atravesse duas Orgs.
model Usuario {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome      String
  email     String
  senhaHash String? @map("senha_hash")
  telefone  String?
  fotoUrl   String? @map("foto_url")

  ativo       Boolean   @default(true)
  ultimoLogin DateTime? @map("ultimo_login")

  acessos   Acesso[]
  auditoria Auditoria[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([orgId, email])
  @@index([orgId])
  @@map("usuarios")
}

/// Permissão é POR UNIDADE, não global.
/// O gerente da loja 3 não enxerga o caixa da loja 5.
model Acesso {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// null = vale para todas as unidades da Org (caso do Dono)
  unidadeId String?  @map("unidade_id")
  unidade   Unidade? @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  papel Papel

  /// Acesso de suporte (nosso) é temporário e precisa de motivo.
  expiraEm DateTime? @map("expira_em")
  motivo   String?

  criadoEm DateTime @default(now()) @map("criado_em")

  @@unique([usuarioId, unidadeId, papel])
  @@index([orgId])
  @@map("acessos")
}

model Convite {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  email     String
  papel     Papel
  unidadeId String? @map("unidade_id")

  token    String    @unique
  expiraEm DateTime  @map("expira_em")
  aceitoEm DateTime? @map("aceito_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([orgId])
  @@map("convites")
}

// ─────────────────────────────────────────────────────────────
// LIVRO DE AUDITORIA
// ─────────────────────────────────────────────────────────────

/// Imutável: só INSERT. Nada de UPDATE nem DELETE (garantido por RLS).
/// Vale para pessoa E para agente — inclusive para o nosso acesso de suporte.
model Auditoria {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unidadeId String?  @map("unidade_id")
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  /// quem fez, guardado como texto também — o nome sobrevive se o usuário sumir
  quem  String
  autor Autor  @default(PESSOA)

  acao      String // "produto.preco.alterou", "caixa.fechou"
  alvoTipo  String? @map("alvo_tipo")
  alvoId    String? @map("alvo_id")
  alvoNome  String? @map("alvo_nome")

  antes  Json?
  depois Json?
  valor  Decimal? @db.Decimal(14, 2)
  motivo String?

  ip        String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([orgId, criadoEm])
  @@index([orgId, alvoTipo, alvoId])
  @@map("auditoria")
}

// ─────────────────────────────────────────────────────────────
// NOSSA COBRANÇA
// ─────────────────────────────────────────────────────────────

model Cobranca {
  id    String @id @default(cuid())
  orgId String @unique @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  provedor       String? // asaas | iugu | vindi
  assinaturaId   String? @map("assinatura_id")
  valorMensal    Decimal @default(0) @db.Decimal(10, 2) @map("valor_mensal")
  unidadesExtras Int     @default(0) @map("unidades_extras")

  proximaCobranca DateTime? @map("proxima_cobranca")
  pagoAte         DateTime? @map("pago_ate")
  tentativas      Int       @default(0)

  atualizadaEm DateTime @updatedAt @map("atualizada_em")

  @@map("cobranca")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Regime {
  MEI
  SIMPLES
  PRESUMIDO
  REAL
}

enum Plano {
  BALCAO
  BALCAO_AGENTE
  REDE
  CORPORATIVO
}

enum Situacao {
  TESTE
  ATIVA
  INADIMPLENTE
  SUSPENSA
  CANCELADA
}

enum Papel {
  DONO
  GERENTE
  BALCAO
  FINANCEIRO
  CONTADOR // convidado, só leitura do financeiro
  SUPORTE // nós, com prazo e motivo
}

enum Autor {
  PESSOA
  AGENTE
  SISTEMA
}

// ═════════════════════════════════════════════════════════════
// FASE 2 — CATÁLOGO E ESTOQUE
// ═════════════════════════════════════════════════════════════
//
// A decisão que sustenta tudo aqui: NADA de "cor" e "tamanho" escritos no
// código. A empresa nomeia os próprios eixos de variação — a loja de roupa
// cria Cor e Tamanho, a sapataria cria Numeração, a sorveteria cria Sabor.
// Com colunas fixas, a sapataria já entraria torta.
//
// E TODO produto tem pelo menos uma variação, mesmo quando não varia. Sem
// isso, estoque e venda teriam dois caminhos ("às vezes é no produto, às
// vezes na variação") — que é exatamente onde bug de estoque nasce.

model Categoria {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome  String
  ordem Int    @default(0)

  /// Subcategoria: "Feminino > Blusas". Um nível já resolve quase todo varejo.
  paiId  String?     @map("pai_id")
  pai    Categoria?  @relation("Subcategorias", fields: [paiId], references: [id])
  filhas Categoria[] @relation("Subcategorias")

  produtos Produto[]

  criadaEm DateTime @default(now()) @map("criada_em")

  @@index([orgId])
  @@map("categorias")
}

/// Um eixo de variação da empresa: "Cor", "Tamanho", "Numeração", "Sabor".
model Eixo {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome  String
  ordem Int     @default(0)
  /// Mostra bolinha colorida na tela em vez de texto (útil para "Cor").
  ehCor Boolean @default(false) @map("eh_cor")

  opcoes   Opcao[]
  produtos ProdutoEixo[]

  @@unique([orgId, nome])
  @@index([orgId])
  @@map("eixos")
}

/// Um valor possível do eixo: "Azul", "M", "38", "Napolitano".
model Opcao {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  eixoId String @map("eixo_id")
  eixo   Eixo   @relation(fields: [eixoId], references: [id], onDelete: Cascade)

  valor String
  ordem Int     @default(0)
  /// Hex, quando o eixo é de cor. A tela mostra a bolinha.
  hex   String?

  variacoes VariacaoOpcao[]

  @@unique([eixoId, valor])
  @@index([orgId])
  @@map("opcoes")
}

model Produto {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome      String
  descricao String?
  marca     String?

  categoriaId String?    @map("categoria_id")
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  /// Como este produto é contado. Vender 0,340 kg de sorvete e vender 1 blusa
  /// precisam caber na mesma venda.
  medida Medida @default(UN)

  /// Três preços, porque no balcão o mesmo produto custa diferente conforme a
  /// forma de pagamento. Nada impede que sejam iguais.
  precoVista     Decimal? @map("preco_vista") @db.Decimal(12, 2)
  precoCartao    Decimal? @map("preco_cartao") @db.Decimal(12, 2)
  precoCrediario Decimal? @map("preco_crediario") @db.Decimal(12, 2)
  custo          Decimal? @db.Decimal(12, 2)

  ativo Boolean @default(true)

  eixos     ProdutoEixo[]
  variacoes Variacao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([orgId, ativo])
  @@index([orgId, categoriaId])
  @@map("produtos")
}

/// Quais eixos este produto usa, e em que ordem aparecem.
model ProdutoEixo {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  eixoId    String  @map("eixo_id")
  eixo      Eixo    @relation(fields: [eixoId], references: [id], onDelete: Cascade)
  ordem     Int     @default(0)

  @@unique([produtoId, eixoId])
  @@index([orgId])
  @@map("produto_eixos")
}

/// O item que de fato existe na prateleira e é vendido.
/// Produto sem variação nenhuma tem UMA variação, com `padrao = true`.
model Variacao {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  /// Código interno da etiqueta. É por aqui que o balcão acha no teclado.
  codigo       String?
  /// EAN-13 de verdade, para leitor comum.
  codigoBarras String? @map("codigo_barras")

  /// Diferença de preço desta variação (tamanho especial custa mais).
  ajustePreco Decimal? @map("ajuste_preco") @db.Decimal(12, 2)

  padrao Boolean @default(false)
  ativa  Boolean @default(true)

  opcoes     VariacaoOpcao[]
  estoques   Estoque[]
  movimentos MovimentoEstoque[]
  vendaItens VendaItem[]

  criadaEm DateTime @default(now()) @map("criada_em")

  @@unique([orgId, codigo])
  @@unique([orgId, codigoBarras])
  @@index([orgId, produtoId])
  @@map("variacoes")
}

model VariacaoOpcao {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  variacaoId String   @map("variacao_id")
  variacao   Variacao @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  opcaoId    String   @map("opcao_id")
  opcao      Opcao    @relation(fields: [opcaoId], references: [id], onDelete: Cascade)

  @@unique([variacaoId, opcaoId])
  @@index([orgId])
  @@map("variacao_opcoes")
}

/// Saldo por variação POR UNIDADE. A loja 3 e a loja 5 contam separado.
model Estoque {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  variacaoId String   @map("variacao_id")
  variacao   Variacao @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  unidadeId  String   @map("unidade_id")
  unidade    Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  /// Decimal porque sorveteria vende 0,340 kg.
  quantidade Decimal  @default(0) @db.Decimal(14, 3)
  minimo     Decimal? @db.Decimal(14, 3)

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([variacaoId, unidadeId])
  @@index([orgId, unidadeId])
  @@map("estoque")
}

/// Todo movimento fica registrado. O saldo é conferível somando isto.
model MovimentoEstoque {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  variacaoId String   @map("variacao_id")
  variacao   Variacao @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  unidadeId  String   @map("unidade_id")
  unidade    Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  tipo TipoMovimento
  /// Positiva para entrada, negativa para saída. Sempre o delta, nunca o saldo.
  quantidade Decimal @db.Decimal(14, 3)
  /// Saldo logo depois deste movimento — para conferir sem refazer a soma toda.
  saldoDepois Decimal @map("saldo_depois") @db.Decimal(14, 3)

  motivo String?
  /// Id da venda, da entrada de mercadoria, do que originou.
  referencia String?
  usuarioId  String? @map("usuario_id")
  quem       String

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([orgId, variacaoId, criadoEm])
  @@index([orgId, unidadeId, criadoEm])
  @@map("movimentos_estoque")
}

enum Medida {
  UN
  KG
  G
  L
  ML
  M
  PAR
  CX
}

enum TipoMovimento {
  ENTRADA
  VENDA
  DEVOLUCAO
  AJUSTE
  PERDA
  TRANSFERENCIA
  BALANCO
}

// ═════════════════════════════════════════════════════════════
// FASE 2 — CLIENTE, VENDA E CAIXA
// ═════════════════════════════════════════════════════════════

model Cliente {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nome      String
  documento String? // CPF
  telefone  String?
  email     String?
  nascimento DateTime? @db.Date

  endereco String?
  numero   String?
  bairro   String?
  cidade   String?
  estado   String?
  cep      String?

  observacoes String?
  ativo       Boolean @default(true)

  vendas Venda[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([orgId, nome])
  @@index([orgId, documento])
  @@map("clientes")
}

/// Um turno de caixa: abre, movimenta, fecha.
/// Venda sempre pertence a um caixa aberto — é assim que o dinheiro do dia
/// tem dono e hora.
model Caixa {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unidadeId String  @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  aberto Boolean @default(true)

  abertoPorId String?  @map("aberto_por_id")
  abertoPor   String   @map("aberto_por")
  abertoEm    DateTime @default(now()) @map("aberto_em")
  saldoAbertura Decimal @default(0) @map("saldo_abertura") @db.Decimal(12, 2)

  fechadoPor String?   @map("fechado_por")
  fechadoEm  DateTime? @map("fechado_em")
  /// O que o sistema diz que devia ter na gaveta.
  saldoEsperado Decimal? @map("saldo_esperado") @db.Decimal(12, 2)
  /// O que a pessoa contou. A diferença entre os dois é o que importa.
  saldoContado  Decimal? @map("saldo_contado") @db.Decimal(12, 2)
  observacoes   String?

  vendas     Venda[]
  movimentos CaixaMovimento[]

  @@index([orgId, unidadeId, aberto])
  @@map("caixas")
}

/// Sangria (tira dinheiro) e suprimento (põe dinheiro), fora de venda.
model CaixaMovimento {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  caixaId String @map("caixa_id")
  caixa   Caixa  @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  tipo   TipoCaixa
  /// Sempre positiva; o sinal vem do tipo.
  valor  Decimal @db.Decimal(12, 2)
  motivo String
  quem   String

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([orgId, caixaId])
  @@map("caixa_movimentos")
}

model Venda {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  unidadeId String  @map("unidade_id")
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  caixaId String? @map("caixa_id")
  caixa   Caixa?  @relation(fields: [caixaId], references: [id])

  /// Número que o cliente vê no comprovante. Sequencial POR UNIDADE — duas
  /// lojas não compartilham numeração, senão o comprovante fica sem sentido.
  numero Int

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /// Quem vendeu. Guardado como texto também: o nome sobrevive à saída da
  /// pessoa da empresa, e a comissão do mês passado não pode mudar.
  vendedorId   String? @map("vendedor_id")
  vendedorNome String? @map("vendedor_nome")

  situacao SituacaoVenda @default(ABERTA)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  desconto Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  observacoes String?

  itens      VendaItem[]
  pagamentos Pagamento[]

  criadaEm    DateTime  @default(now()) @map("criada_em")
  concluidaEm DateTime? @map("concluida_em")
  canceladaEm DateTime? @map("cancelada_em")
  motivoCancelamento String? @map("motivo_cancelamento")

  @@unique([unidadeId, numero])
  @@index([orgId, unidadeId, criadaEm])
  @@index([orgId, situacao])
  @@map("vendas")
}

/// Item vendido. Guarda FOTOGRAFIA de nome e preço.
///
/// Sem isso, renomear um produto ou mudar o preço reescreveria o histórico:
/// a venda de março passaria a mostrar o preço de hoje, e o relatório do mês
/// fechado mudaria sozinho.
model VendaItem {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  vendaId String @map("venda_id")
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  variacaoId String   @map("variacao_id")
  variacao   Variacao @relation(fields: [variacaoId], references: [id])

  /// fotografia
  descricao String
  codigo    String?
  medida    Medida  @default(UN)

  quantidade  Decimal @db.Decimal(14, 3)
  precoUnit   Decimal @map("preco_unit") @db.Decimal(12, 2)
  desconto    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  /// Custo do momento da venda — é o que permite calcular a margem depois.
  custoUnit   Decimal? @map("custo_unit") @db.Decimal(12, 2)

  @@index([orgId, vendaId])
  @@index([orgId, variacaoId])
  @@map("venda_itens")
}

/// Uma venda pode ter várias formas de pagamento: metade no cartão, metade
/// em dinheiro. Por isso é lista, não campo.
model Pagamento {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  vendaId String @map("venda_id")
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  forma    FormaPagamento
  valor    Decimal @db.Decimal(12, 2)
  parcelas Int     @default(1)
  /// Bandeira, autorização, chave do Pix — o que ajuda a conciliar depois.
  referencia String?

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([orgId, vendaId])
  @@map("pagamentos")
}

enum SituacaoVenda {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum TipoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  CREDIARIO
  VALE
  TRANSFERENCIA
}
