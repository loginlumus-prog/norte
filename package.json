{
  "name": "norte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "banco": "tsx scripts/banco-local.ts",
    "preparar": "tsx scripts/preparar-banco.ts",
    "conferir": "tsx scripts/conferir.ts",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "db:gerar": "prisma generate",
    "db:ddl": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > prisma/sql/tabelas.sql",
    "db:studio": "prisma studio",
    "tipos": "tsc --noEmit",
    "dev": "tsx scripts/tudo.ts",
    "dev:so-web": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.4",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
