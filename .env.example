# Postgres com RLS. O usuario da aplicacao NAO pode ser superuser nem dono
# das tabelas, senao o RLS e ignorado silenciosamente.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# So para migracao e para aplicar o RLS. Nunca usar em requisicao.
DATABASE_URL_ADMIN="postgresql://postgres:senha@host:5432/postgres?sslmode=require"

# Assinatura do cookie de sessao. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SEGREDO_SESSAO=""
