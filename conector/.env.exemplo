# Copie para .env (que NÃO vai para o git) e preencha.

# O MESMO valor do CONECTOR_SEGREDO do Norte. 32+ caracteres. Gerar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONECTOR_SEGREDO=

# O endereço do Norte (https em produção; http só para localhost).
NORTE_URL=https://norte.app

# A porta deste serviço.
PORT=3200

# O MESMO ROTINAS_SEGREDO do Norte. Com ele, o conector também é o relógio:
# acorda as campanhas a cada minuto e roda as rotinas do assistente (relatório
# das 8h e 20h, "vai faltar", cliente sumido) a cada hora. Sem ele, é preciso
# um cron batendo em /api/campanhas/tick e /api/rotinas.
ROTINAS_SEGREDO=

# Opcionais — o ritmo de envio de cada número (ver src/ritmo.ts):
# RITMO_INTERVALO_MIN_MS=3000
# RITMO_INTERVALO_MAX_MS=8000
# RITMO_POR_MINUTO=12
# RITMO_POR_DIA=500
# RITMO_POR_CONTATO_MINUTO=6
# FILA_MAXIMA=50
# IDADE_MAXIMA_MIN=360
